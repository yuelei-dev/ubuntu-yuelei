{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huangque.example/schemas/test-release-impact-v1.json",
  "additionalProperties": false,
  "properties": {
    "external_checks": {
      "items": { "$ref": "#/$defs/externalCheck" },
      "type": "array"
    },
    "health_checks": {
      "items": { "$ref": "#/$defs/healthCheck" },
      "minItems": 1,
      "type": "array"
    },
    "migrations": {
      "items": { "$ref": "#/$defs/migration" },
      "type": "array"
    },
    "pre_health_checks": {
      "items": { "$ref": "#/$defs/healthCheck" },
      "type": "array"
    },
    "release_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$",
      "type": "string"
    },
    "required_env": {
      "items": { "pattern": "^[A-Z][A-Z0-9_]{0,79}$", "type": "string" },
      "type": "array",
      "uniqueItems": true
    },
    "restart_services": {
      "items": {
        "pattern": "^[A-Za-z0-9@_.:-]+\\.(service|timer)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "runtime_changes": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": { "const": 1 }
  },
  "required": [
    "schema_version",
    "release_id",
    "runtime_changes",
    "restart_services",
    "required_env",
    "pre_health_checks",
    "health_checks",
    "external_checks",
    "migrations"
  ],
  "title": "Huangque test release impact",
  "type": "object",
  "$defs": {
    "command": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": { "minLength": 1, "type": "string" },
          "minItems": 1,
          "type": "array"
        },
        "cwd": { "enum": ["{source}", "{runtime}"] },
        "timeout_seconds": { "maximum": 1800, "minimum": 1, "type": "integer" }
      },
      "required": ["argv"],
      "type": "object"
    },
    "externalCheck": {
      "additionalProperties": false,
      "properties": {
        "argv": { "$ref": "#/$defs/command/properties/argv" },
        "cwd": { "$ref": "#/$defs/command/properties/cwd" },
        "name": { "minLength": 1, "type": "string" },
        "no_charge": { "const": true },
        "timeout_seconds": { "$ref": "#/$defs/command/properties/timeout_seconds" }
      },
      "required": ["name", "no_charge", "argv"],
      "type": "object"
    },
    "healthCheck": {
      "additionalProperties": false,
      "properties": {
        "expected_statuses": {
          "items": { "maximum": 599, "minimum": 100, "type": "integer" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "interval_seconds": { "maximum": 5, "minimum": 0.1, "type": "number" },
        "timeout_seconds": { "maximum": 120, "minimum": 1, "type": "integer" },
        "url": { "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/", "type": "string" }
      },
      "required": ["url", "expected_statuses"],
      "type": "object"
    },
    "migration": {
      "additionalProperties": false,
      "properties": {
        "database_path": { "pattern": "^/", "type": "string" },
        "id": { "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$", "type": "string" },
        "rollback": { "const": "restore_sqlite_snapshot" },
        "up": { "$ref": "#/$defs/command" },
        "verify": { "$ref": "#/$defs/command" }
      },
      "required": ["id", "database_path", "up", "verify", "rollback"],
      "type": "object"
    }
  }
}
