      "service": "huangque-content.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/content_api.py",
      "runtime": "/home/ubuntu/content-api/content_api.py",
      "service": "huangque-content.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/func_names.py",
      "runtime": "/home/ubuntu/content-api/func_names.py",
      "service": "huangque-content.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/tikhub.py",
      "runtime": "/home/ubuntu/content-api/tikhub.py",
      "service": "huangque-content.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/imggen_api.py",
      "runtime": "/home/ubuntu/content-api/imggen_api.py",
      "service": "huangque-imggen-api.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/admin_api.py",
      "runtime": "/home/ubuntu/content-api/admin_api.py",
      "service": "huangque-admin.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/leadgen_api.py",
      "runtime": "/home/ubuntu/content-api/leadgen_api.py",
      "service": "huangque-leadgen-api.service"
    },
    {
      "delete_allowed": false,
      "kind": "exact",
      "mode": "0644",
      "repository": "server/auth_server.py",
