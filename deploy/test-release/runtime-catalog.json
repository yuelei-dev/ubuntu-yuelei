  "health_probes": {
    "admin-health": { "description": "GET http://127.0.0.1:8098/api/admin/health expects HTTP 200" },
    "auth-health": { "description": "GET http://127.0.0.1:8095/api/auth/health expects HTTP 200" },
    "bitable-sync-contract": { "description": "Validate hq_bitable_sync_server.py without sending a Feishu request" },
    "content-health": { "description": "GET http://127.0.0.1:8096/api/gen/health expects HTTP 200" },
    "dl-health": { "description": "GET http://127.0.0.1:8097/api/gen/dl/health expects HTTP 200" },
    "drift-sentinel-contract": { "description": "Run drift_sentinel.py --print without alerts or baseline writes" },
    "egress-active": { "description": "huangque-egress-tunnel.service is active; no paid request is submitted" },
    "hermes-health": { "description": "GET http://127.0.0.1:3102/healthz expects HTTP 200" },
    "imggen-health": { "description": "GET http://127.0.0.1:8101/api/gen/banana/health expects HTTP 200" },
    "invite-claims-active": { "description": "huangque-invite-reward-claims.service is active when invoked" },
    "invite-claims-timer-active": { "description": "huangque-invite-reward-claims.timer is active" },
    "leadgen-a-active": { "description": "leadgen-A.service is active" },
    "leadgen-api-health": { "description": "GET http://127.0.0.1:8100/api/gen/leadgen/health expects HTTP 200" },
    "leadgen-b-active": { "description": "leadgen-B.service is active" },
    "site-loopback": { "description": "GET the approved nginx loopback site endpoint without triggering a task" },
    "xiaotan-active": { "description": "xiaotan.service is active" }
  },
  "service_health_probes": {
    "hermes-ip12-preview.service": "hermes-health",
    "huangque-admin.service": "admin-health",
    "huangque-auth.service": "auth-health",
    "huangque-content.service": "content-health",
    "huangque-dl.service": "dl-health",
    "huangque-egress-tunnel.service": "egress-active",
    "huangque-imggen-api.service": "imggen-health",
    "huangque-invite-reward-claims.service": "invite-claims-active",
    "huangque-invite-reward-claims.timer": "invite-claims-timer-active",
    "huangque-leadgen-api.service": "leadgen-api-health",
    "leadgen-A.service": "leadgen-a-active",
    "leadgen-B.service": "leadgen-b-active",
    "xiaotan.service": "xiaotan-active"
  },
  "min_free_bytes": 16777216,
  "runtime_owner_rules": [
    { "runtime_prefix": "/etc/", "owner": "root", "group": "root" },
    { "runtime_prefix": "/home/ubuntu/", "owner": "ubuntu", "group": "ubuntu" },
    { "runtime_prefix": "/var/www/", "owner": "www-data", "group": "www-data" }
