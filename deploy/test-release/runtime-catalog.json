{
  "allowed_tools": [
    "/usr/bin/curl",
    "/usr/bin/env",
    "/usr/bin/ffmpeg",
    "/usr/bin/ffprobe",
    "/usr/bin/python3",
    "/usr/bin/systemctl"
  ],
  "allowed_units": [
    "hermes-ip12-preview.service",
    "huangque-admin.service",
    "huangque-auth.service",
    "huangque-content.service",
    "huangque-dl.service",
    "huangque-egress-tunnel.service",
    "huangque-imggen-api.service",
