      "runtime": "/home/ubuntu/dl-service/dl_service.py",
      "service": "huangque-dl.service"
    },
    {
      "delete_allowed": true,
      "kind": "prefix",
      "mode": "0644",
      "repository": "site/",
      "runtime": "/var/www/huangquechuanmei/",
      "service": null
    },
    {
      "daemon_reload": true,
      "delete_allowed": false,
      "kind": "prefix",
      "mode": "0644",
      "repository": "deploy/systemd/",
      "runtime": "/etc/systemd/system/",
      "service": null,
      "service_from_repository": true
    }
