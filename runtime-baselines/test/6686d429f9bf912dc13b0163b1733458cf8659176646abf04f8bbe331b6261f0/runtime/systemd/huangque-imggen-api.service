# /etc/systemd/system/huangque-imggen-api.service
[Unit]
Description=Huangque 作图后端 nano banana (独立于 content_api)
After=network.target
[Service]
EnvironmentFile=/home/ubuntu/content-api/content.env
WorkingDirectory=/home/ubuntu/content-api
ExecStart=/usr/bin/python3 /home/ubuntu/content-api/imggen_api.py
Restart=always
User=ubuntu
[Install]
WantedBy=multi-user.target

# /etc/systemd/system/huangque-imggen-api.service.d/hardening.conf
# huangque-imggen-api 启动加固（崩溃风暴限速 + 抢占残留端口 + 优雅停机）
# 落地：/etc/systemd/system/huangque-imggen-api.service.d/hardening.conf
# 部署后：sudo systemctl daemon-reload && sudo systemctl restart huangque-imggen-api
#
# ExecStartPre 的 fuser 是给「上次没停干净、端口还被占着」兜底的：
# 前缀 '-' 表示失败不阻止启动；'|| true' 保证没有占用者时也返回 0。
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
ExecStartPre=-/bin/sh -c 'fuser -k 8101/tcp 2>/dev/null || true'
KillMode=mixed
TimeoutStopSec=15
RestartSec=5

# /etc/systemd/system/huangque-imggen-api.service.d/internal-token.conf
# huangque-imggen-api 读取内部点数接口令牌
# 落地：/etc/systemd/system/huangque-imggen-api.service.d/internal-token.conf
# 部署后：sudo systemctl daemon-reload && sudo systemctl restart huangque-imggen-api
#
# imggen 的主单元只加载 content.env，而 HQ_INTERNAL_TOKEN 在 auth.env 里。
# 缺了这个 drop-in，imggen 的退点会拿到 500「HQ_INTERNAL_TOKEN 未配置」，
# 用户的点退不回来（该服务没有直写 users.db 的兜底）。
[Service]
EnvironmentFile=-/home/ubuntu/auth-service/auth.env
